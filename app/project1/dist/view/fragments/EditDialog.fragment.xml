<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="editDialog"
        title="Edit Employee"
        draggable="true"
        resizable="true"
        class="sapUiContentPadding">

        <content>
            <VBox class="sapUiSmallMargin">

                <Input id="empId" editable="false" placeholder="Employee ID"/>
                <Input id="empName" placeholder="Name"/>
                <Input id="empDept" placeholder="Department"/>
                <Input id="empEmail" placeholder="Email"/>

            </VBox>
        </content>

        <beginButton>
            <Button text="Save" press="onDialogSave" type="Emphasized"/>
        </beginButton>

        <endButton>
            <Button text="Cancel" press="onDialogCancel" type="Emphasized"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>