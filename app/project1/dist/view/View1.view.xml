            <Panel class="employeePanel sapUiLargeMarginTop">
                <headerToolbar>
                    <Toolbar class="employeeToolbar">

                        <Title text="Employee Details"
                              class="employeeTitle" />

                        <ToolbarSpacer />
                        <Button
                        text="Choose Excel"
                        icon="sap-icon://excel-attachment"
                        press=".onOpenExcelDialog"
                        type="Emphasized"
                         class="excelButton"
                       />
                        <Button
                            icon="sap-icon://refresh"
                            text="Refresh"
                            tooltip="Refresh Employees"
                            press=".onRefreshEmployees"
                            class="refreshButton"
                        />
                    </Toolbar>
                </headerToolbar>
                <VBox  class="employeeVBox">
                    <!-- <Button
                        text="Choose Excel"
                        icon="sap-icon://excel-attachment"
                        press=".onOpenExcelDialog"
                        type="Emphasized"
                    /> -->

                    <Table
                        id="employeeTable"
                        items="{/Employees}"
                        mode="None"
                        class="employeeTable"
                    >
                        <columns>
                            <Column>
                                <Text text="Employee ID" />
                            </Column>
                            <Column>
                                <Text text="Name" />
                            </Column>
                            <Column>
                                <Text text="Department" />
                            </Column>
                            <Column>
                                <Text text="Email" />
                            </Column>
                            <Column>
                                <Text text="Actions" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                type="Active"
                                press=".onEmployeeRowPress"
                                class="employeeRow"
                            >
                                <cells>
                                    <Text text="{EmployeeID}" />
                                    <Text text="{Name}" />
                                    <Text text="{Department}" />
                                    <Text text="{Email}" />

                                    <Button
                                        icon="sap-icon://edit"
                                        press=".onEditPress"
                                         class="editButton"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
