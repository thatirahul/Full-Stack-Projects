<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="cameraDialog"
        title="Capture Photo"
        contentWidth="400px">

        <core:HTML
            id="cameraHtml"
            sanitizeContent="false"
            content="&lt;video id='cameraVideo' autoplay playsinline style='width:100%;height:320px;border-radius:8px;'&gt;&lt;/video&gt;" />

        <beginButton>
            <Button
                text="Capture"
                press=".onTakePhoto"/>
        </beginButton>

        <endButton>
            <Button
                text="Close"
                press=".onCloseCameraDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>