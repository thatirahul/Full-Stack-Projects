<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
>
    <Dialog
        title="Education Information"
        contentWidth="500px"
    >
        <VBox class="sapUiMediumMargin">
            <Label
                text="Education Type"
                required="true"
            />

            <Select id="educationTypeInput">
                <items>
                    <core:Item
                        key="Secondary"
                        text="12th Secondary Education"
                    />

                    <core:Item
                        key="Graduation"
                        text="Graduation"
                    />

                    <core:Item
                        key="PostGraduation"
                        text="Post Graduation"
                    />
                </items>
            </Select>
            <VBox class="sapspacing sapUiSmallMarginTop">
                <Label
                    text="Choose Entry Method"
                    design="Bold"
                />

                <RadioButtonGroup
                    id="entryModeGroup"
                    columns="2"
                    selectedIndex="-1"
                    select=".onEntryModeChange"
                    enabled="{ui>/enableEntryMode}"
                >
                    <buttons>
                        <RadioButton text="Upload Certificate" />

                        <RadioButton text="Enter Manually" />
                    </buttons>
                </RadioButtonGroup>
            </VBox>
          
          <VBox visible="{ui>/showUpload}">
            <!-- Upload Certificate -->
            <Label text="Upload Certificate" />

            <unified:FileUploader
                id="certificateUploader"
                visible="{= !${ui>/manualEntry} }"
                width="100%"
                buttonText="Choose Certificate"
                placeholder="Upload 12th / Graduation / PG Certificate"
                fileType="jpg,jpeg,png"
                sameFilenameAllowed="true"
                change="onCertificateUpload"
                enabled="{employee>/isEducationAddMode}"
            />
    </VBox>
            <!-- <Button
                text="Add"
                type="Emphasized"
                press=".onAddExtractedEducation"
                class="sapUiTinyMarginBegin"/> -->
                 <VBox visible="{ui>/showFields}">
            <Label
                text="Qualification"
                required="true"
            />
            <Input id="qualificationInput" />

            <Label text="Specialization" />
            <Input id="specializationInput" />

            <Label
                text="Institution"
                required="true"
            />
            <Input id="institutionInput" />

            <Label
                text="Passing Year"
                required="true"
            />
            <Input
                id="passingYearInput"
                type="Number"
            />

            <Label text="Percentage" />
            <Input
                id="percentageInput"
                type="Text"
            />

            <Label text="Grade" />
            <Input id="gradeInput" />
        </VBox>
</VBox>
        <beginButton>
            <Button
                text="Save"
                press="onSaveEducation"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseEducationDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
