<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="Employment Information"
        contentWidth="500px">

        <VBox class="sapUiMediumMargin">

            <Label text="Designation"/>
            <Input id="designationInput"/>

            <Label text="Manager"/>
            <Input id="managerInput"/>

            <Label text="Joining Date"/>
            <DatePicker id="joiningDateInput"
                valueFormat="yyyy-MM-dd"
                displayFormat="dd/MM/yyyy"/>

            <Label text="Employment Type"/>
            <Input id="employmentTypeInput"/>

            <Label text="Status"/>
            <Select id="statusInput">
                <items>
                    <core:Item key="Active" text="Active"/>
                    <core:Item key="Inactive" text="Inactive"/>
                </items>
            </Select>

        </VBox>

        <beginButton>
            <Button
                text="Save"
                press="onSaveEmploymentInfo"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseEmploymentDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>