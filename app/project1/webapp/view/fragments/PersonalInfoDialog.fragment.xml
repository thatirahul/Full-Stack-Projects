<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="Personal Information"
        contentWidth="500px">

        <VBox class="sapUiMediumMargin">

            <Label text="Mobile"/>
            <Input id="mobileInput"/>

            <Label text="Home Phone"/>
            <Input id="homePhoneInput"/>

            <Label text="Address"/>
            <Input id="addressInput"/>

            <Label text="City"/>
            <Input id="cityInput"/>

            <Label text="State"/>
            <Input id="stateInput"/>

            <Label text="Country"/>
            <Input id="countryInput"/>

            <!-- <Label text="Bank Name"/>
            <Input id="bankNameInput"/>

            <Label text="Account Number"/>
            <Input id="accountNumberInput"/>

            <Label text="IFSC"/>
            <Input id="ifscInput"/> -->

        </VBox>

        <beginButton>
            <Button
                text="Save"
                press="onSavePersonalInfo"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onClosePersonalDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>