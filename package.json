{
  "name": "document-ai-test",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.17.0",
    "@sap/cds-dk": "^9",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy document-ai-test --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
 "cds": {
  "requires": {
    "db": {
      "kind": "hana"
    },
    "[development]": {
      "db": {
        "kind": "sqlite"
      }
    },
    "[production]": {
      "auth": "xsuaa"
    }
  },
  "server": {
    "body_parser": {
      "limit": "20mb"
    }
  }
}
}
