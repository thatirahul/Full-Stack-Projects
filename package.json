{
  "name": "uploadexcel",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@google/genai": "^2.10.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy uploadexcel --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "Admin": {
            "password": "alice",
            "roles": [
              "Admin"
            ]
          },
          "Employee": {
            "password": "bob",
            "roles": [
              "Employee"
            ]
          }
        }
      },
      "db": {
        "kind": "sqlite"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "hana"
        }
      },
      "auth": {
        "kind": "jwt"
      }
    }
  }
}
